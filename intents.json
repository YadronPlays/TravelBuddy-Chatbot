{
  "title": "TravelBuddy",
  "intents": [
    {
      "tag": "greeting",
      "patterns": ["hello", "hi", "hey", "good morning", "good evening", "yo", "howdy", "hiya", "morning", "evening"],
      "responses": [
        "Hi there! I'm TravelBuddy — your travel assistant.",
        "Hello traveler! Where would you like to go next?",
        "Hey! Ready to plan your next trip?"
      ]
    },
    {
      "tag": "acknowledgment",
      "patterns": ["how are you", "how you doing", "are you ok", "how is your day", "how's it going", "what's up", "feeling good?"],
      "responses": [
        "I'm doing great, thank you! How about you?",
        "It has been great, thank you! How about you?",
        "The day has been good, thanks for asking!"
      ]
    },
    {
      "tag": "feeling",
      "patterns": [
        "i am (?P<feeling>doing great|amazing|well|good|fantastic|fabulous|terrific)",
        "i am feeling (?P<feeling>great|amazing|good|fantastic|fabulous|terrific)",
        "the day has been (?P<feeling>good)",
        "i feel (?P<feeling>happy|excited|tired|stressed|amazing)"
      ],
      "responses": [
        "That's great to hear! Are you planning to go on a trip soon?",
        "I'm glad! Do you want travel suggestions?",
        "Nice to hear that! Are you thinking of visiting a new country?"
      ]
    },
    {
      "tag": "goodbye",
      "patterns": ["bye", "goodbye", "see you", "quit", "exit", "later", "end chat", "catch you later", "farewell"],
      "responses": [
        "Goodbye and safe travels!",
        "See you next time — may your adventures be amazing!",
        "Farewell! Don’t forget your passport!"
      ]
    },
    {
      "tag": "name_query",
      "patterns": ["what is your name", "who are you", "tell me your name", "your name"],
      "responses": ["I'm TravelBuddy, your personal trip planner."]
    },
    {
      "tag": "remember_name",
      "patterns": ["my name is (?P<name>.+)", "i am (?P<name>.+)", "call me (?P<name>.+)", "i'm (?P<name>.+)"],
      "responses": [
        "Nice to meet you, {name}! Ready to explore the world together?",
        "Great to meet you, {name}! Where would you like to travel?",
        "Hello {name}! I'm here to help with your travel plans."
      ]
    },
    {
      "tag": "recall_name",
      "patterns": ["what's my name", "what is my name", "do you remember my name", "tell me my name"],
      "responses": ["You told me your name is {name}!"]
    },
    {
      "tag": "holiday_interest",
      "patterns": [
        "i want to go for a (?P<holiday>vacation|trip|holiday|break)",
        "i need a (?P<holiday>vacation|trip|holiday|break)",
        "i want to plan a (?P<holiday>vacation|holiday)"
      ],
      "responses": ["Which continent are you thinking of going to?"]
    },
    {
      "tag": "continent_interest",
      "patterns": [
        "i want to go to (?P<continent>Africa|Asia|Europe|North America|South America|Oceania)",
        "i'm planning to visit (?P<continent>Africa|Asia|Europe|North America|South America|Oceania)",
        "can you tell me about (?P<continent>Africa|Asia|Europe|North America|South America|Oceania)"
      ],
      "responses": ["Which country in {continent} interests you?"]
    },
    {
      "tag": "country_interest",
      "patterns": [
        "i want to go to (?P<country>[A-Za-z ]+)",
        "i'm planning to visit (?P<country>[A-Za-z ]+)",
        "can you tell me about (?P<country>[A-Za-z ]+)"
      ],
      "responses": [
        "{country} sounds amazing! I can suggest attractions, food, and travel tips there.",
        "Ah, {country}! Great choice — when are you planning to go?"
      ]
    },
    {
      "tag": "weather",
      "patterns": [
        "what's the weather in (?P<location>.+)",
        "how's the weather in (?P<location>.+)",
        "is it raining in (?P<location>.+)"
      ],
      "responses": [
        "I can’t fetch live weather, but I hope it’s sunny in {location}!",
        "If you’re packing for {location}, always bring layers — weather changes fast!"
      ]
    },
    {
      "tag": "ask_budget",
      "patterns": [
        "how much does it cost to go to (?P<country>[A-Z][a-z]+)",
        "what's the budget for (?P<country>[A-Z][a-z]+)",
        "is (?P<country>[A-Z][a-z]+) expensive"
      ],
      "responses": [
        "Costs for {country} vary, but you can save money by eating local food, using public transport, and staying in hostels or guesthouses.",
        "Traveling to {country} doesn’t have to be expensive! Use local buses, avoid tourist restaurants, and book flights early.",
        "For {country}, budget travellers usually save money by using public transport, eating street food, and choosing budget hotels or Airbnbs."
      ]
    },

    {
      "tag": "ask_flights",
      "patterns": [
        "what flights go to (?P<country>[A-Z][a-z]+)",
        "how can I fly to (?P<country>[A-Z][a-z]+)",
        "which airlines go to (?P<country>[A-Z][a-z]+)"
      ],
      "responses": [
        "You can find good flights to {country} using Skyscanner, Google Flights, or Expedia — they compare prices from many airlines.",
        "For flights to {country}, try checking Skyscanner or Google Flights. They usually show the best budget and fastest options.",
        "Looking for flights to {country}? Head to Skyscanner — it’s great for comparing cheap, direct, and fast routes."
      ]
    },

    {
      "tag": "fallback",
      "patterns": [".*"],
      "responses": [
        "I'm not sure about that, but I can help with flights, destinations, or travel tips!",
        "Could you rephrase that? I can suggest hotels, food, or places to visit.",
        "Hmm, I didn't get that. Maybe try asking about your next destination?"
      ]

    }
  ],
